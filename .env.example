# -----------------------------------------------------------------------
# HICKS Salon — Environment Variables
# Copy this file to .env for local development (vercel dev reads .env).
# Configure the same keys in Vercel → Project → Settings → Environment
# Variables for Preview/Production.
# -----------------------------------------------------------------------

# Neon PostgreSQL connection string
# Found in: Neon Console -> Project -> Connection Details -> Pooled connection
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Brevo (formerly Sendinblue) transactional email API key
# Found in: Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=

# Sender identity for outgoing transactional email (set up + verify in Brevo)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HICKS Salon

# Reserved for future admin authentication (not implemented yet)
ADMIN_SESSION_SECRET=
